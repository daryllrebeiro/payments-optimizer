# Dependency directories
node_modules/

# Build directories (individual package builds)
dist/
build/
out/
*.tsbuildinfo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Coverage reports and test output
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.eslintcache

# Operating System files
.DS_Store
Thumbs.db

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local

# Emitted TS build artifacts accidentally placed next to sources
# (tsc without outDir). Keep these local-only; never commit.
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map
apps/*/src/**/*.js
apps/*/src/**/*.d.ts
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts.map

# Local agent/tooling state
.kilo/
.kilocode/
.opencode/
agents/
